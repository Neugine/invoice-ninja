# Invoice Ninja Environment Variables
# Copy this file to .env and update with your values

# Application
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.railway.app
APP_KEY=base64:YOUR_GENERATED_KEY_HERE
APP_CIPHER=AES-256-CBC

# Database (These will be auto-populated by Railway)
DB_CONNECTION=mysql
DB_HOST=mysql.railway.internal
DB_PORT=3306
DB_DATABASE=railway
DB_USERNAME=root
DB_PASSWORD=password
DB_STRICT=false

# Security
REQUIRE_HTTPS=true

# Mail (Optional - Configure if you need email functionality)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Queue (Optional - For background jobs)
QUEUE_CONNECTION=database

# Session
SESSION_DRIVER=file

# Cache
CACHE_DRIVER=file
